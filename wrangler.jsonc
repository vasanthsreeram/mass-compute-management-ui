{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpu-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "7efeb52ec5727a903edd8ef7ae8eb925",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "massedui.vasanth.cloud", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    // "none": asset paths are served exactly, so the Worker decides what "/" and "/app" mean.
    "html_handling": "none",
    "run_worker_first": ["/", "/app", "/app/*", "/api/*", "/mcp", "/health", "/gpu-proxy.sh", "/skill/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gpu-proxy",
      "database_id": "d9c6a93e-9287-4609-8746-6c418e600987",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "MOCK_MASSED": "0",
    "MAIL_FROM": "noreply@massedui.vasanth.cloud",
    // Used in emails (e.g. "connection lost"). Falls back to the origin of the last admin connect.
    "APP_URL": "https://massedui.vasanth.cloud",
    "AGENT_TOKEN_DAYS": "30"
  },
  "send_email": [{ "name": "EMAIL" }],
  "ai": {
    "binding": "AI"
  }
}
